message I’m at the merge gate’s first safe checkpoint. I’m checking only the branch shape and release policy now; no merge, push, tag, PR, or deployment can occur before the readiness checks and confirmations
shell /bin/zsh -lc "git status --short --branch git remote -v git branch --show-current if [ -f .agents/scripts/script-policy-read.py ]; then python3 .agents/scripts/script-policy-read.py; else echo POLICY_SCRIPT_MISSING; fi if [ -f AGENTS.md ]; then echo AGENTS_PRESENT; fi if [ -f CLAUDE.md ]; then echo CLAUDE_PRESENT; fi if [ -f devkit/policy.json ]; then sed -n '1,240p' devkit/policy.json; else echo POLICY_FILE_ABSENT; fi"
shell /bin/zsh -lc 'pwd ls -la find .. -maxdepth 2 -name .git -print 2>/dev/null'
