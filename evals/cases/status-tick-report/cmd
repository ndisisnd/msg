# S11 — a tick after the cadence interval has elapsed emits REPORT plus the
# full rendered block. This run carries all five possible lines (header,
# done:, now:, issues:, next:) so the block's shape — including the ⏱/·
# glyphs — is pinned in one golden.
S="$REPO/.claude/scripts/script-status-tick.sh"
"$S" --start --phase build --run-id r1 --total 10 --label "batch A" --now 1754000000 >/dev/null
"$S" --tick --run-id r1 --step "compiling" --done 3 --note "wrote foo" --finding high --next "run tests" --now 1754000400
