# Several devices and no --device: the choice is the user's, so ASK_DEVICE is
# raised. Every installed device is emitted (DEVICE_1..n) so the prompt can
# offer all of them, and a suggested default comes with it so the prompt always
# has a (Recommended) option — and so a dismissed prompt still has an answer.
chmod +x stub/*
PATH="$PWD/stub:/usr/bin:/bin" bash "$REPO/.claude/scripts/script-emulate-preflight.sh" \
  --platform android \
  | grep -E '^(DEVICE_COUNT|DEVICE_[0-9]+_NAME|DEVICE_DEFAULT_NAME|DEVICE_DEFAULT_SOURCE|DEVICE_NAME|ASK_DEVICE)='
