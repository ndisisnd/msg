# S11 — regression guard (fixed during P0): a report on a run with none of
# --step/--label/--next/--total renders exactly two lines (REPORT + header),
# no empty line and no trailing space anywhere. A re-introduced empty `now: `
# line (e.g. from printing --step unconditionally) must fail this golden.
S="$REPO/.claude/scripts/script-status-tick.sh"
"$S" --start --phase build --run-id m1 --now 1754000000 >/dev/null
"$S" --tick --run-id m1 --now 1754000300
