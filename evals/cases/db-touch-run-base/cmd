# script-eng-db-touch.sh checks only this run's own changes: a migration an
# earlier agent committed on the branch (before the run base) is not flagged;
# a .sql file this run adds after the base is.
export GIT_AUTHOR_NAME=fixture GIT_AUTHOR_EMAIL=fixture@example.invalid
export GIT_COMMITTER_NAME=fixture GIT_COMMITTER_EMAIL=fixture@example.invalid
export GIT_AUTHOR_DATE="2026-01-15T00:00:00Z" GIT_COMMITTER_DATE="2026-01-15T00:00:00Z"
G="git -c commit.gpgsign=false"
$G init -q --initial-branch=main
echo seed > README && $G add -A && $G commit -q -m seed
$G checkout -q -b feat/prd-1-x
mkdir -p migrations && echo "create table a();" > migrations/001_a.sql
$G add -A && $G commit -q -m "earlier agent migration"
RUN_BASE=$($G rev-parse HEAD)
mkdir -p src && echo "x" > src/app.ts && $G add -A && $G commit -q -m "this run, code"
echo "select 1;" > src/report.sql
"$REPO/.claude/scripts/script-eng-db-touch.sh" "$RUN_BASE"
