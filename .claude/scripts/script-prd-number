#!/usr/bin/env bash
# script-prd-number — deterministic n-resolver for plan-pm and plan-em
#
# Usage:
#   script-prd-number prd <row-#>          the PRD number for intake row <row-#> (plan-pm):
#                                          the row number itself. Exit 3 + NUMBER_CLASH=<n>
#                                          when a PRD folder with that number already exists.
#   script-prd-number prd                  legacy: next free number after the highest PRD
#   script-prd-number sub <parent-n>       next available sub-PRD minor for parent <parent-n>
#                                          (plan-pm --sub); the sub-PRD and its intake row
#                                          are both <parent-n>.<m>
#
# Run from the project root. Reads features/ and, for `sub`, INTAKE.md.
#
# PRD number = intake row number: row #7 becomes prd-7-<slug>, row #7.1 becomes
# prd-7.1-<slug>. Numbers have gaps (rows never planned, deleted rows); old PRDs
# keep the numbers they already have.

set -euo pipefail

mode="${1:-}"

case "$mode" in
  prd)
    row="${2:-}"
    if [[ -n "$row" ]]; then
      row="${row#\#}"
      [[ "$row" =~ ^[0-9]+$ ]] || { echo "script-prd-number prd: row-# must be a whole number, got '$row'" >&2; exit 1; }
      # Any PRD folder with this exact number, in any lane or nesting depth, is
      # a clash. `prd-<n>-*` never matches a sub-PRD `prd-<n>.<m>-*`.
      if [[ -d features ]]; then
        hit=$(find features -type d -name "prd-$row-*" 2>/dev/null | sort | head -n 1)
        if [[ -n "$hit" ]]; then
          echo "NUMBER_CLASH=$row"
          echo "script-prd-number: intake row #$row maps to prd-$row, but $hit already exists — refusing; the PRD number must equal the row number" >&2
          exit 3
        fi
      fi
      echo "$row"
      exit 0
    fi
    max=0
    # Lane-agnostic: a PRD may sit in any of the three lifecycle lanes or at the
    # legacy flat path. Scan all four; a missing glob expands to a literal that
    # `[[ -d ]]` rejects, so no nullglob is needed. Duplicates across lanes never
    # happen (one PRD, one lane), and even if they did max-of-max is unaffected.
    for dir in features/prd-*/ \
               features/planned/prd-*/ \
               features/wip/prd-*/ \
               features/done/prd-*/; do
      [[ -d "$dir" ]] || continue
      base="${dir%/}"; base="${base##*/}"   # prd-<n>-<slug>
      n="${base#prd-}"
      [[ "$n" =~ ^([0-9]+) ]] || continue
      n="${BASH_REMATCH[1]}"
      (( n > max )) && max=$n
    done

    # A9 — the four globs above are lane-shaped: a PRD parked anywhere else under
    # features/ (a new lane, an archive folder, a nesting depth nobody planned) is
    # invisible to them, and the number we are about to hand out would collide with
    # it. Sweep lane-agnostically and refuse rather than mint a duplicate id.
    next=$(( max + 1 ))
    if [[ -d features ]]; then
      collide=0
      while IFS= read -r d; do
        base="${d##*/}"                       # prd-<n>[.<m>]-<slug>
        n="${base#prd-}"
        [[ "$n" =~ ^([0-9]+) ]] || continue
        n="${BASH_REMATCH[1]}"
        (( n >= next && n > collide )) && collide=$n
      done < <(find features -type d -name 'prd-*' 2>/dev/null)
      if (( collide > 0 )); then
        echo "NUMBER_COLLISION=$collide"
        echo "script-prd-number: a PRD folder numbered $collide exists under features/ but sits outside the scanned lanes — refusing to hand out $next; move it into a lane (planned/wip/done) first" >&2
        exit 2
      fi
    fi

    echo "$next"
    ;;

  sub)
    parent="${2:-}"
    [[ -n "$parent" ]] || { echo "Usage: script-prd-number sub <parent-n>" >&2; exit 1; }
    [[ "$parent" =~ ^[0-9]+$ ]] || { echo "script-prd-number sub: parent-n must be numeric, got '$parent'" >&2; exit 1; }
    max=0
    # Sub-PRDs live nested inside the parent's folder as
    #   features/[<lane>/]prd-<parent>-<slug>/prd-<parent>.<m>-<sub_slug>/
    # The parent folder may be in any lane (or the legacy flat path); scan all.
    # Scan for the highest existing minor <m> and return the next one (.1 if none).
    for dir in features/prd-"$parent"-*/prd-"$parent".*-*/ \
               features/planned/prd-"$parent"-*/prd-"$parent".*-*/ \
               features/wip/prd-"$parent"-*/prd-"$parent".*-*/ \
               features/done/prd-"$parent"-*/prd-"$parent".*-*/; do
      [[ -d "$dir" ]] || continue
      base="${dir%/}"
      base="${base##*/}"                 # prd-<parent>.<m>-<sub_slug>
      rest="${base#prd-"$parent".}"      # <m>-<sub_slug>
      [[ "$rest" =~ ^([0-9]+) ]] || continue
      m="${BASH_REMATCH[1]}"
      (( m > max )) && max=$m
    done
    # The sub-PRD's intake row is #<parent>.<m>. A row captured for a sub-PRD
    # that was never drafted still holds its minor, so count ledger rows too.
    if [[ -f INTAKE.md ]]; then
      while IFS= read -r m; do
        (( m > max )) && max=$m
      done < <(grep -oE "^\|[[:space:]]*#?$parent\.[0-9]+[[:space:]]*\|" INTAKE.md 2>/dev/null \
                 | sed -E "s/^\|[[:space:]]*#?$parent\.([0-9]+).*/\1/")
    fi
    echo $(( max + 1 ))
    ;;

  *)
    echo "Usage: script-prd-number prd [<row-#>] | script-prd-number sub <parent-n>" >&2
    exit 1
    ;;
esac
